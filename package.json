{
  "name": "obsidian-multivault-mcp",
  "version": "1.0.0",
  "type": "module",
  "description": "Multi-vault, multi-user MCP server giving Claude read/write access to Obsidian vaults on a VPS — over ssh stdio and an OAuth-protected HTTP transport, where each user's login routes to their own vault.",
  "license": "MIT",
  "author": "Asep Bagja Priandana <bepitulaz@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bepitulaz/obsidian-multivault-mcp.git"
  },
  "homepage": "https://github.com/bepitulaz/obsidian-multivault-mcp#readme",
  "bugs": {
    "url": "https://github.com/bepitulaz/obsidian-multivault-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "obsidian",
    "claude",
    "oauth",
    "multi-vault"
  ],
  "bin": {
    "obsidian-multivault-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "smoke:http": "node scripts/smoke-http.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "verify": "npm run test && npm run typecheck && npm run build && npm run smoke && npm run smoke:http"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "gray-matter": "^4.0.3",
    "jose": "^6.0.0",
    "zod": "^3.23.8"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
